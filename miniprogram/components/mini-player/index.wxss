@import "../../styles/icons.wxss";

.mini { position: fixed; left: 20rpx; right: 20rpx; bottom: calc(116rpx + env(safe-area-inset-bottom)); z-index: 45; height: 104rpx; display: flex; align-items: center; padding: 0 12rpx 0 28rpx; border-radius: 28rpx; background: var(--deep); color: var(--on-deep); overflow: hidden; box-shadow: 0 12rpx 32rpx -16rpx rgba(17, 19, 24, 0.5); }
.eq { display: flex; align-items: flex-end; height: 28rpx; width: 28rpx; flex: none; }
.eb { width: 5rpx; height: 40%; margin-right: 4rpx; border-radius: 3rpx; background: var(--hl-strong); animation: eq 0.9s ease-in-out infinite; }
.eb:nth-child(2) { animation-delay: -0.3s; }
.eb:nth-child(3) { animation-delay: -0.6s; }
.eq.paused .eb { animation-play-state: paused; opacity: 0.6; }
@keyframes eq { 0%, 100% { height: 30%; } 50% { height: 100%; } }
.text { flex: 1; min-width: 0; margin: 0 20rpx; }
.title { font-size: 26rpx; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.line { font-family: var(--f-read); font-size: 24rpx; opacity: 0.72; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2rpx; }
.btn { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; flex: none; }
.play { font-size: 40rpx; }
.close { width: 60rpx; opacity: 0.6; }
.x { font-size: 40rpx; line-height: 1; }
.bar { position: absolute; left: 0; right: 0; bottom: 0; height: 4rpx; background: var(--deep-2); }
.fill { height: 100%; background: var(--hl-strong); }
