page { height: 100%; overflow: hidden; }
.wrap { height: 100vh; display: flex; flex-direction: column; position: relative; }

.bar { flex: none; display: flex; align-items: center; justify-content: space-between; padding: 8rpx 32rpx 16rpx; }
.seg { display: flex; background: var(--surface-2); border-radius: 20rpx; padding: 6rpx; }
.seg-b { font-size: 26rpx; padding: 8rpx 26rpx; border-radius: 16rpx; color: var(--fg-2); }
.seg-b.on { background: var(--surface); color: var(--fg); font-weight: 600; box-shadow: 0 2rpx 4rpx rgba(17, 19, 24, 0.12); }
.counter { font-size: 25rpx; color: var(--dim); }

.tip { flex: none; margin: 0 32rpx 12rpx; padding: 16rpx 20rpx 16rpx 24rpx; border-radius: 24rpx; background: var(--surface-2); font-size: 25rpx; color: var(--fg-2); display: flex; align-items: center; }
.tip-t { flex: 1; }
.tip-hl { color: var(--fg); background: linear-gradient(to top, transparent 0.1em, var(--hl) 0.1em, var(--hl) 0.55em, transparent 0.55em); }
.tip-ok { margin-left: 16rpx; font-weight: 600; color: var(--fg); flex: none; }

.cues { flex: 1; height: 0; }
.cue { padding: 24rpx 44rpx; position: relative; }
.meta { display: flex; align-items: center; height: 32rpx; margin-bottom: 6rpx; font-size: 22rpx; color: var(--dim); }
.ts { font-family: var(--f-num); }
.cue.on .ts { color: var(--fg); }
.eq { display: flex; align-items: flex-end; height: 20rpx; margin-right: 10rpx; }
.eb { width: 4rpx; height: 40%; margin-right: 3rpx; border-radius: 2rpx; background: var(--fg); animation: eq 0.9s ease-in-out infinite; }
.eb:nth-child(2) { animation-delay: -0.3s; }
.eb:nth-child(3) { animation-delay: -0.6s; }
.eq.paused .eb { animation-play-state: paused; }
@keyframes eq { 0%, 100% { height: 30%; } 50% { height: 100%; } }

.en { font-family: var(--f-read); font-size: 35rpx; line-height: 1.55; color: var(--dim); transition: color 0.25s; }
.cue.on .en { color: var(--fg); }
.zh { font-size: 27rpx; line-height: 1.55; color: var(--dim); margin-top: 8rpx; }
.cue.on .zh { color: var(--fg-2); }
.a { background: linear-gradient(to top, transparent 0.06em, var(--hl-dim) 0.06em, var(--hl-dim) 0.52em, transparent 0.52em); }
.cue.on .a { background: linear-gradient(to top, transparent 0.06em, var(--hl) 0.06em, var(--hl) 0.52em, transparent 0.52em); }
.cue .sel, .cue.on .a.sel { background: var(--hl-strong); border-radius: 4rpx; }
.blur .en, .blur .zh { filter: blur(12rpx); }
.reveal { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -30%); font-size: 24rpx; background: var(--ink); color: var(--on-ink); padding: 8rpx 20rpx; border-radius: 999rpx; white-space: nowrap; }
.tail { height: 50vh; }

.follow { position: absolute; left: 50%; transform: translateX(-50%); bottom: calc(392rpx + env(safe-area-inset-bottom)); z-index: 5; display: flex; align-items: center; font-size: 26rpx; font-weight: 600; padding: 16rpx 28rpx; border-radius: 999rpx; background: var(--ink); color: var(--on-ink); box-shadow: 0 12rpx 32rpx -12rpx rgba(17, 19, 24, 0.5); }
.follow .i { margin-right: 10rpx; }

.dock { flex: none; border-top: 1rpx solid var(--line); background: var(--bg); padding: 24rpx 36rpx calc(20rpx + env(safe-area-inset-bottom)); }
.wave { position: relative; height: 76rpx; }
.bars { position: absolute; left: 0; top: 0; bottom: 0; display: flex; align-items: center; }
.base { right: 0; }
.b { flex: 1; margin: 0 1.5rpx; border-radius: 2rpx; background: var(--wave); }
.clip { position: absolute; top: 0; bottom: 0; overflow: hidden; }
.cur .b { background: var(--wave-cur); }
.cur.loop .b { background: var(--hl-strong); }
.played .b { background: var(--fg); }
.times { display: flex; justify-content: space-between; font-family: var(--f-num); font-size: 22rpx; color: var(--dim); margin-top: 4rpx; }

.ctrls { display: flex; justify-content: space-around; align-items: flex-start; margin-top: 8rpx; }
.cb { width: 120rpx; display: flex; flex-direction: column; align-items: center; font-size: 21rpx; color: var(--dim); }
.cb .ic { width: 84rpx; height: 84rpx; margin-bottom: 4rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; color: var(--fg); font-size: 44rpx; }
.cb.on { color: var(--fg); }
.cb.on .ic { background: var(--hl-strong); }
.rate { font-family: var(--f-num); font-size: 27rpx; font-weight: 600; }
.play { width: 120rpx; height: 120rpx; border-radius: 50%; background: var(--ink); color: var(--on-ink); display: flex; align-items: center; justify-content: center; font-size: 52rpx; margin-top: -12rpx; }

.rate-mask { position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 8; }
.rate-panel { position: absolute; left: 24rpx; right: 24rpx; bottom: calc(300rpx + env(safe-area-inset-bottom)); z-index: 9; background: var(--surface); border: 1rpx solid var(--line); border-radius: 28rpx; padding: 20rpx 20rpx 24rpx; box-shadow: 0 16rpx 48rpx -16rpx rgba(17, 19, 24, 0.35); }
.rp-title { font-size: 23rpx; font-weight: 600; letter-spacing: 1rpx; color: var(--dim); margin: 0 4rpx 16rpx; }
.rp-opts { display: flex; }
.rp-opt { flex: 1; height: 72rpx; margin: 0 4rpx; border-radius: 18rpx; background: var(--surface-2); color: var(--fg); display: flex; align-items: center; justify-content: center; font-family: var(--f-num); font-size: 25rpx; font-weight: 600; }
.rp-opt.on { background: var(--ink); color: var(--on-ink); }
.play.loading { animation: pulse 1s ease-in-out infinite alternate; }
@keyframes pulse { from { opacity: 1; } to { opacity: 0.45; } }
